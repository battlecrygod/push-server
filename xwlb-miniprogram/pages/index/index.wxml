<view class="page" wx:if="{{view}}">
  <view class="masthead">
    <view class="masthead__date">{{view.displayDate}}</view>
    <view class="masthead__meta">
      <text wx:if="{{relative}}">{{relative}}</text>
      <text>{{view.weekday}}</text>
      <text>{{view.pointCount}} 条要点</text>
    </view>
  </view>

  <view class="notice" wx:if="{{notice}}">{{notice}}</view>

  <view class="digest">
    <view class="digest__label">
      <view class="digest__dot"></view>
      <text>一句话看懂</text>
    </view>
    <view class="digest__text" wx:if="{{!digestLoading}}">{{digest}}</view>
    <view class="digest__text digest__text--loading" wx:else>正在提炼昨日要闻…</view>
    <view class="digest__hint">由大模型依据联播条目生成</view>
  </view>

  <view class="section">
    <view class="section__head">
      <text class="section__title">主要内容</text>
      <text class="section__count">{{view.mainCount}} 条</text>
    </view>

    <view class="brief-list">
      <view class="brief-item" wx:for="{{view.mains}}" wx:key="key">
        <view class="brief-item__index">{{item.index}}</view>
        <view class="brief-item__body">
          <view class="brief-item__title">{{item.title}}</view>
          <view class="tag {{item.tagClass}}">{{item.tag}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{view.flashes.length}}">
    <view class="section__head">
      <text class="section__title">联播快讯</text>
      <text class="section__count">{{view.flashes.length}} 组</text>
    </view>

    <view class="flash-group" wx:for="{{view.flashes}}" wx:key="key">
      <view class="flash-group__title">{{item.title}}</view>
      <view class="flash-item" wx:for="{{item.children}}" wx:for-item="child" wx:key="key">
        <text class="flash-item__index">{{child.index}}</text>
        <text class="flash-item__text">{{child.title}}</text>
      </view>
    </view>
  </view>

  <view class="action-row">
    <view class="btn btn--plain action-row__btn" bindtap="onOpenArchive">查看往期</view>
    <view class="btn btn--plain action-row__btn" bindtap="onCopyVideo" wx:if="{{view.videoUrl}}">
      复制原片链接
    </view>
  </view>

  <view class="subscribe">
    <view class="subscribe__body">
      <view class="subscribe__title">每天早上，收到昨日要点</view>
      <view class="subscribe__desc" wx:if="{{quota > 0}}">已开启 {{quota}} 次推送</view>
      <view class="subscribe__desc" wx:else>微信服务通知，一条一次授权</view>
    </view>
    <view class="subscribe__btn" bindtap="onSubscribe">开启</view>
  </view>

  <view class="footer-note">内容整理自央视网《新闻联播》公开节目信息</view>
</view>

<view class="empty" wx:else>正在加载…</view>
