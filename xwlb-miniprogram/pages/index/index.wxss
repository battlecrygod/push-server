.digest__text--loading {
  color: #a6adb8;
}

/* 操作行 */
.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}

.action-row__btn {
  flex: 1;
  height: 84rpx;
  font-size: 27rpx;
}

/* 订阅卡 */
.subscribe {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  background: linear-gradient(135deg, #fff7f6 0%, #ffffff 60%);
  border: 1rpx solid #f6e2e0;
  border-radius: 24rpx;
}

.subscribe__body {
  flex: 1;
  min-width: 0;
}

.subscribe__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2a2d33;
}

.subscribe__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa1aa;
}

.subscribe__btn {
  flex: none;
  margin-left: 20rpx;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
}
