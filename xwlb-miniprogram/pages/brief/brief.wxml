<view class="page">
  <view class="brief-head">
    <view class="brief-head__date">{{dateText}}</view>
    <view class="brief-head__title">{{title}}</view>
    <view class="tag {{tagClass}}">{{tag}}</view>
  </view>

  <view class="notice" wx:if="{{state === 'nourl'}}">
    这条暂无对应文字稿，可能当天没有单独成条。可以回到列表看整期内容。
  </view>

  <view class="notice notice--error" wx:if="{{state === 'error'}}">{{errorText}}</view>

  <block wx:if="{{children.length}}">
    <view class="section__head">
      <text class="section__title">快讯条目</text>
      <text class="section__count">{{children.length}} 条</text>
    </view>
    <view class="brief-list">
      <view class="brief-item" wx:for="{{children}}" wx:key="*this">
        <view class="brief-item__index">{{index + 1}}</view>
        <view class="brief-item__body">
          <view class="brief-item__title">{{item}}</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{state === 'ok'}}">
    <view class="article">
      <view class="article__para" wx:for="{{paragraphs}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="article__source">文字稿来自央视网</view>
  </block>

  <view class="empty" wx:if="{{state === 'loading'}}">正在加载正文…</view>

  <view class="btn btn--plain brief-retry" wx:if="{{state === 'error'}}" bindtap="onRetry">
    重新加载
  </view>
</view>
